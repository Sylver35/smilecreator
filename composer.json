{
    "name": "sylver35/smilecreator",
    "type": "phpbb-extension",
    "description": "Breizh Smilies Creator Extension for phpBB. Allows to create smilies with text you want",
    "homepage": "https://breizhcode.com",
    "version": "1.6.0",
    "time": "2025-08-27",
    "keywords": ["phpbb", "extension", "smilies", "creator", "breizh", "breizh smilies creator"],
    "license": "GPL-2.0-only",
     "authors": [
        {
            "name": "sylver35",
			"email": "webmaster@breizhcode.com",
            "homepage": "https://breizhcode.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.2",
        "ext-gd": "*",
        "composer/installers": "~2.0.0",
        "phpbb/phpbb": ">=3.3.10"
    },
	 "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "display-name": "Breizh Smilies Creator",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.10"
        },
        "version-check": {
            "host": "breizhversions.com",
            "directory": "/smilecreator",
            "filename": "version_check.json",
            "ssl": false
        }
    }
}
